# ============================================
# VARIABLES DE ENTORNO - Paz y Salvo SENA
# Copia este archivo como .env y ajusta valores
# ============================================

# Django
DJANGO_SECRET_KEY=genera-una-clave-con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=es
DJANGO_TIME_ZONE=America/Bogota

# Base de datos
# Local (MySQL):
DATABASE_URL=mysql://root:root@localhost:3306/pazysalvo

# Produccion (PostgreSQL / Supabase):
# Formato: postgres://usuario:password@host:puerto/nombre_bd
# DATABASE_URL=postgres://postgres:password@db.xxxxx.supabase.co:5432/postgres
